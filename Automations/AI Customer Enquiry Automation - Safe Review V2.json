    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI Customer Support Assistant for a software company.\n\nYour task is to analyze incoming customer enquiries and produce a structured analysis together with a professional email reply.\n\nCustomer Information\n\nSource:\n{{ $json.source }}\n\nCustomer Name:\n{{ $json.customer_name }}\n\nCustomer Email:\n{{ $json.customer_email }}\n\nSubject:\n{{ $json.subject }}\n\nMessage:\n{{ $json.message }}\n\nAnalyze the enquiry and perform the following tasks:\n\n1. Classify the enquiry into EXACTLY ONE category:\n- Sales\n- Support\n- Billing\n- Feedback\n- Other\n\n2. Determine a confidence score from 0 to 100.\n\n3. Determine the priority:\n- Low\n- Medium\n- High\n\n4. Determine the sentiment:\n- Positive\n- Neutral\n- Negative\n\n5. Write a concise summary suitable for logging into Google Sheets (maximum 15 words).\n\n6. Explain briefly why the enquiry belongs to the selected category.\n\n7. Generate a professional email reply.\n\nRules for the email reply:\n\n- Start with:\nHello {{ $json.customer_name }},\n\n- If the customer's name is missing, simply use:\nHello,\n\n- Thank the customer for contacting us.\n\n- Answer the customer's enquiry clearly and professionally.\n\n- If pricing, technical information, or other details are unavailable, politely state that a member of the team will contact them shortly.\n\n- Never invent prices, dates, features, or promises.\n\n- Never mention that you are an AI.\n\n- Never use \"Dear\".\n\n- Never use placeholders like [Your Name].\n\n- End the email with:\n\nBest regards,\n\nAI Customer Support Team\n\nIMPORTANT:\n\nReturn ONLY valid JSON.\n\nDo NOT wrap the response inside markdown.\n\nDo NOT include explanations.\n\nDo NOT include code fences.\n\nReturn EXACTLY this JSON structure.\n\n{\n  \"category\": \"\",\n  \"confidence\": 0,\n  \"priority\": \"\",\n  \"sentiment\": \"\",\n  \"summary\": \"\",\n  \"reason\": \"\",\n  \"draft_reply\": \"\"\n}",
        "batching": {}
      },
      "id": "90941615-77f4-4464-961e-33c4421f402d",
      "name": "Analyze Enquiry (Groq)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -1024,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  let text = item.json.text || \"\";\n\n  text = text.replace(/```json/gi, \"\");\n  text = text.replace(/```/g, \"\").trim();\n\n  try {\n    const parsed = JSON.parse(text);\n\n    const requiredFields = [\n      \"category\",\n      \"confidence\",\n      \"priority\",\n      \"sentiment\",\n      \"summary\",\n      \"reason\",\n      \"draft_reply\"\n    ];\n\n    const missingFields = requiredFields.filter(\n      (field) => parsed[field] === undefined || parsed[field] === null\n    );\n\n    if (missingFields.length > 0) {\n      throw new Error(`Missing required fields: ${missingFields.join(\", \")}`);\n    }\n\n    return {\n      json: {\n        ...parsed,\n        confidence: Number(parsed.confidence) || 0,\n        processing_status: \"success\",\n        processing_error: \"\"\n      }\n    };\n  } catch (error) {\n    return {\n      json: {\n        category: \"Other\",\n        confidence: 0,\n        priority: \"High\",\n        sentiment: \"Neutral\",\n        summary: \"AI output requires manual review\",\n        reason: `Processing error: ${error.message}`,\n        draft_reply: \"\",\n        processing_status: \"failed\",\n        processing_error: error.message\n      }\n    };\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -704,
        64
      ],
      "id": "281d0976-a101-4e7c-acc2-6ff54bfb0776",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const json = item.json || {};\n\n  const fromAddress =\n    json.from?.value?.[0]?.address ||\n    json.from?.text ||\n    json.headers?.from ||\n    \"\";\n\n  const fromText = String(fromAddress).toLowerCase();\n\n  const headersText =\n    typeof json.headers === \"string\"\n      ? json.headers.toLowerCase()\n      : JSON.stringify(json.headers || {}).toLowerCase();\n\n  const blockedSenderPatterns = [\n    \"no-reply\",\n    \"noreply\",\n    \"do-not-reply\",\n    \"donotreply\",\n    \"mailer-daemon\",\n    \"postmaster\",\n    \"notifications@\",\n    \"notification@\",\n    \"alerts@\",\n    \"alert@\",\n    \"github.com\",\n    \"mail.n8n.cloud\"\n  ];\n\n  const automatedHeaderPatterns = [\n    \"auto-submitted: auto-\",\n    \"\\\"auto-submitted\\\":\\\"auto-\",\n    \"precedence: bulk\",\n    \"\\\"precedence\\\":\\\"bulk\",\n    \"precedence: list\",\n    \"\\\"precedence\\\":\\\"list\",\n    \"list-unsubscribe\",\n    \"x-autoreply\",\n    \"x-autorespond\",\n    \"x-auto-response-suppress\"\n  ];\n\n  const blockedSender = blockedSenderPatterns.find((pattern) =>\n    fromText.includes(pattern)\n  );\n\n  const automatedHeader = automatedHeaderPatterns.find((pattern) =>\n    headersText.includes(pattern)\n  );\n\n  const hasReplyableAddress =\n    fromText.includes(\"@\") &&\n    !fromText.includes(\"mailer-daemon\") &&\n    !fromText.includes(\"postmaster\");\n\n  const isCustomerCandidate =\n    Boolean(hasReplyableAddress) &&\n    !blockedSender &&\n    !automatedHeader;\n\n  return {\n    json: {\n      ...json,\n      email_filter_is_customer_candidate: isCustomerCandidate,\n      email_filter_reason: isCustomerCandidate\n        ? \"Passed sender and automated-message checks\"\n        : blockedSender\n          ? `Blocked sender pattern: ${blockedSender}`\n          : automatedHeader\n            ? `Automated email header detected: ${automatedHeader}`\n            : \"No replyable sender address found\"\n    }\n  };\n});"
      },
